# Copy to .env and adjust. .env is never committed (spec §12).
DATABASE_URL=postgres://minime:minime@localhost:5432/minime
# scripts/install.sh provisions a restricted minime_app role and atomically writes these two
# private values to .env. DATABASE_URL stays the owner/control-plane DSN for migrations and
# maintenance.
#MINIME_APP_DATABASE_URL=postgres://minime_app:<generated-secret>@localhost:5432/minime
#MINIME_APP_PASSWORD=<generated-secret>
# Ollama is local-only by construction. Allowed: http/https localhost (one unbracketed
# trailing dot only), canonical 127/8 IPv4, or bracketed ::1; a trailing dot on bracketed
# IPv6 or numeric IPv4 is syntax-invalid; optional port/base path. Credentials, redirects,
# proxies, DNS aliases, LAN/public hosts, and noncanonical numeric IPv4 are refused.
OLLAMA_URL=http://localhost:11434

# Archive root. Unset/empty = <Minime repository>/data. Relative values resolve from the
# repository root, not the shell/MCP host cwd; absolute values are used as-is. Changing this
# setting does not move existing data.
#MINIME_DATA_DIR=data

# Optional LOCAL cross-encoder rerank stage (Phase 3; big precision lift — see
# docs/benchmarks/). Localhost only (I1) — remote URLs are refused. Fail-open: search
# works unchanged when the server is down. Serve with:
#   llama-server -m ~/models/bge-reranker-v2-m3-Q8_0.gguf --rerank --port 8114 \
#     -ub 4096 -b 4096 --parallel 4 -c 16384
#RERANK_URL=http://localhost:8114
#RERANK_MODEL=bge-reranker-v2-m3
#RERANK_TOP_IN=20
EMBED_MODEL=nomic-embed-text        # 768 dims; changing model requires re-embed migration
CLASSIFY_MODEL=llama3.1:8b

# ---- LLM provider routing -----------------------------------------------------------
# Owner's standing configuration (2026-06-12): CLASSIFY_PROVIDER=bedrock (IAM creds via
# ~/.aws or env; BEDROCK_MODEL required) and EMBED_PROVIDER=openrouter
# (qwen/qwen3-embedding-8b @ 768). Local Ollama is an OPTION/fallback, not the
# preference — benchmarks and the dream cycle should run against the standing config;
# scorecards stamp the models used.
# Cloud providers send tier <= CLOUD_MAX_TIER content off-box; every call is audited
# in `events` (verb egress:*) and shows up in `minime audit`. Tier 0 NEVER leaves.
# embed: ollama | openai | openrouter (768-dim constraint).  classify: any provider below.
EMBED_PROVIDER=ollama
CLASSIFY_PROVIDER=ollama
# lower to 1 to keep journal/interactions local-only
CLOUD_MAX_TIER=2
# Per-tier classify routing (W3): stricter-only overrides of CLASSIFY_PROVIDER. Recommended
# standing config: tier-2 journals/interactions classified locally, tier-1 on the cloud model.
# A cloud route above CLOUD_MAX_TIER refuses to start. Raw inbox captures route as tier 2.
# PROVIDER_ROUTE_TIER0 accepts only the literal `none` (or unset) — tier-0 is never classified.
#PROVIDER_ROUTE_TIER2=ollama
#PROVIDER_ROUTE_TIER1=bedrock
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-opus-4-8
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-4o-mini
#OPENAI_EMBED_MODEL=text-embedding-3-small
#OPENROUTER_API_KEY=
#OPENROUTER_MODEL=openai/gpt-4o-mini
#OPENROUTER_EMBED_MODEL=qwen/qwen3-embedding-8b   # must honor dimensions=768; run `reembed` after switching
#BEDROCK_MODEL=                     # e.g. us.anthropic.claude-opus-4-8 (list-inference-profiles)
# SkillEval/SkillOpt TARGET agent (the model that executes skills under test) — pin a
# CHEAP model so skill quality, not model strength, is measured; the optimizer keeps
# the full classify model. Same provider as CLASSIFY_PROVIDER, different model id.
#SKILL_TARGET_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
# Dedicated Bedrock-only IAM principal used by resident serve. Do not reuse an S3 backup key.
#BEDROCK_AWS_ACCESS_KEY_ID=
#BEDROCK_AWS_SECRET_ACCESS_KEY=
#BEDROCK_AWS_SESSION_TOKEN=
#BEDROCK_AWS_REGION=
TZ=Asia/Singapore
TIER2_UNLOCK_MAX_MINUTES=60
# Local disk or cloud object storage — restic encrypts client-side either way
# (DECISIONS.md 2026-06-11). Cloud examples:
#   RESTIC_REPOSITORY=b2:minime-backup:restic        (+ B2_ACCOUNT_ID / B2_ACCOUNT_KEY)
#   RESTIC_REPOSITORY=s3:s3.amazonaws.com/minime-backup  (+ AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
RESTIC_REPOSITORY=/mnt/backup/minime-restic
RESTIC_PASSWORD_FILE=~/.config/minime/restic.pass
DREAM_CRON=0 3 * * *
# Frequent logical DB snapshots (tag db-snap, retention 48h/7d), independent of the
# nightly dream backup. Empty string disables; requires RESTIC_REPOSITORY set.
BACKUP_CRON=*/15 * * * *
