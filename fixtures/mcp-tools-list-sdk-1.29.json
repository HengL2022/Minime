  {
    "name": "minime_log_decision",
    "description": "Record a decision or six-question decision interview with options, choice/reasoning, falsifier, stakes, reversibility, confidence, transcript turns, branch rows, tier, and review date. Open decisions surface in minime_state.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "choice": {
          "type": "string"
        },
        "reasoning": {
          "type": "string"
        },
        "expected_outcome": {
          "type": "string"
        },
        "falsifier": {
          "type": "string"
        },
        "stakes": {
          "type": "string"
        },
        "reversibility": {
          "type": "string",
          "enum": [
            "reversible",
            "costly",
            "irreversible"
          ]
        },
        "confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "decided_at": {
          "type": "string"
        },
        "review_at": {
          "type": "string"
        },
        "tier": {
          "type": "number",
          "enum": [
            1,
            2
          ]
        },
        "transcript": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question_key": {
                "type": "string",
                "enum": [
                  "fork",
                  "falsifier",
                  "tension",
                  "prediction",
                  "stakes",
                  "review",
                  "freeform"
                ]
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "answer": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "question_key",
              "prompt",
              "answer"
            ],
            "additionalProperties": false
          }
        },
        "branches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "chosen",
                  "rejected",
                  "considered"
                ]
              },
              "note": {
                "type": "string"
              },
              "would_be_right_if": {
                "type": "string"
              }
            },
            "required": [
              "label"
            ],
            "additionalProperties": false
          }
        },
        "review_in_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "time_zone": {
          "type": "string",
          "description": "IANA timezone for interpreting date-only input and rendering timestamps."
        },
        "timezone": {
          "type": "string",
          "description": "Alias for time_zone."
        }
      },
      "required": [
        "question",
        "options"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
